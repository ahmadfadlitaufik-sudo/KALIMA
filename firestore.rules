rules_version = '2';

// Aturan akses database Kalima.
// - Hanya akun yang emailnya terverifikasi DAN terdaftar aktif di kalima_users boleh membaca/menulis data.
// - Hanya Owner yang boleh mengubah daftar pengguna.
// - Email di isBootstrapOwner() selalu Owner (harus sama dengan BOOTSTRAP_OWNER_EMAILS di src/services/firebase.ts).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedInVerified() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function staffPath(email) {
      return /databases/$(database)/documents/kalima_users/$(email);
    }

    function isBootstrapOwner() {
      return signedInVerified() && myEmail() in ['ahmadfadlitaufik@gmail.com'];
    }

    function isActiveStaff() {
      return signedInVerified()
        && exists(staffPath(myEmail()))
        && get(staffPath(myEmail())).data.active == true;
    }

    function isStaff() {
      return isBootstrapOwner() || isActiveStaff();
    }

    function isOwner() {
      return isBootstrapOwner()
        || (isActiveStaff() && get(staffPath(myEmail())).data.role == 'owner');
    }

    function isValidStaffRecord(userEmail) {
      let data = request.resource.data;
      return userEmail == userEmail.lower()
        && data.email == userEmail
        && data.name is string
        && data.role in ['owner', 'admin']
        && data.active is bool;
    }

    // Data operasional (pesanan, stok, master, keuangan, operasional, audit).
    match /kalima_workspace/{docId} {
      allow read, write: if isStaff();
    }

    // Daftar pengguna yang diizinkan masuk. ID dokumen = email huruf kecil.
    match /kalima_users/{userEmail} {
      allow read: if isStaff() || (signedInVerified() && userEmail == myEmail());
      allow create, update: if isOwner() && isValidStaffRecord(userEmail);
      allow delete: if isOwner() && userEmail != myEmail();
    }

    // Semua koleksi lain ditolak.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
