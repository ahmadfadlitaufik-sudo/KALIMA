        "jumlah": { "type": "number", "required": true },
        "deskripsi": { "type": "string", "required": true }
      }
    },
    "CashAccount": {
      "collection": "cashAccounts",
      "fields": {
        "id": { "type": "string", "required": true },
        "name": { "type": "string", "required": true },
        "saldo": { "type": "number", "required": true }
